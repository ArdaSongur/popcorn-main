---
import BaseLayout from "../layouts/BaseLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import HoroscopeFeatureCard from "../components/HoroscopeFeatureCard.astro";
import StructuredData from "../components/StructuredData.astro";
import data from "../data/data.json";
import articles from "../data/articles.json";
import { sortArticlesNewest } from "../utils/articles.js";
import { createWebSiteStructuredData } from "../utils/seo.js";

const featuredMovies = data.movies.slice(0, 4);
const articleSections = [
    { category: "astroloji", title: "✨ Astroloji" },
    { category: "kultur-sanat", title: "🎨 Kültür & Sanat" },
    { category: "yemek-tarifleri", title: "🍴 Yemek Tarifleri" },
    { category: "ruya-tabirleri", title: "🌙 Rüya Tabirleri" },
    { category: "kisisel-gelisim", title: "🧠 Kişisel Gelişim" },
    { category: "evcil-hayvanlar", title: "🐾 Evcil Hayvanlar" }
].map((section) => ({
    ...section,
    articles: sortArticlesNewest(
        articles.filter((article) => article.category === section.category)
    ).slice(0, 3)
}));
---


<BaseLayout
    title="Popcorn | Film, Astroloji, Kültür ve Lifestyle"
    description="Film, dizi, astroloji, yemek tarifleri, kültür sanat, rüya tabirleri, kişisel gelişim ve evcil hayvan içerikleri."
    canonicalPath="/"
>

    <StructuredData data={createWebSiteStructuredData()} />

    <div class="home-container">

        <section class="home-hero">

            <div class="home-hero-content">
                <span class="home-hero-label">
                    POPCORN'DA ÖNE ÇIKANLAR
                </span>

                <h1 id="homeHeroTitle" aria-live="polite">Keşfedecek çok şey var.</h1>

                <p>
                    Film ve dizilerden burç rehberlerine,
                    yemek tariflerinden kültür ve sanata kadar
                    Popcorn'un öne çıkan içeriklerini keşfet.
                </p>
            </div>

        </section>


        <section class="home-section">

            <div class="section-header">
                <h2>🎬 Filmler & Diziler</h2>
                <a href="/film-dizi/">Tümünü Gör →</a>
            </div>

           <div class="placeholder-grid">
    {featuredMovies.map((movie) => (
        <MovieCard item={movie} />
    ))}
</div>

        </section>


        <section class="home-section">
            <HoroscopeFeatureCard />
        </section>


        <div class="ad-placeholder">
            Reklam Alanı
        </div>


        {articleSections.map((section) => (
            <section class="home-section">
                <div class="section-header">
                    <h2>{section.title}</h2>
                    <a href={`/${section.category}/`}>Tümünü Gör →</a>
                </div>

                <div class="article-list home-article-list">
                    {section.articles.map((article) => <ArticleCard article={article} />)}
                </div>
            </section>
        ))}

    </div>

    <script>
        import { supabase } from "../lib/supabase.js";

        const heroTitle = document.getElementById("homeHeroTitle");
        const defaultTitle = "Keşfedecek çok şey var.";

        const renderWelcome = async (session) => {
            if (!session?.user) {
                if (heroTitle) heroTitle.textContent = defaultTitle;
                return;
            }

            const { data: profile } = await supabase
                .from("profiles")
                .select("*")
                .eq("id", session.user.id)
                .maybeSingle();

            const name = profile?.display_name?.trim()
                || profile?.username?.trim()
                || session.user.user_metadata?.display_name?.trim()
                || session.user.user_metadata?.username?.trim();
            if (heroTitle) {
                heroTitle.textContent = name
                    ? `Hoş geldin ${name}, keşfedecek çok şey var.`
                    : defaultTitle;
            }
        };

        const { data: { session } } = await supabase.auth.getSession();
        await renderWelcome(session);

        supabase.auth.onAuthStateChange((_event, nextSession) => {
            void renderWelcome(nextSession);
        });
    </script>

</BaseLayout>
