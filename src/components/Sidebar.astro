---
const pathname = Astro.url.pathname;

const isActive = (path) => {
    if (path === "/") return pathname === "/";
    const pathWithoutTrailingSlash = path.replace(/\/$/, "");
    return pathname === pathWithoutTrailingSlash || pathname.startsWith(path);
};
---

<aside class="sidebar" id="sidebar" aria-label="Ana menü">

    <button
        class="sidebar-collapse-button"
        id="sidebarCollapseButton"
        type="button"
        aria-label="Kenar çubuğunu daralt"
        aria-expanded="true"
        title="Kenar çubuğunu daralt"
    >
        <span aria-hidden="true">‹</span>
    </button>

    <a href="/" class="sidebar-logo" aria-label="Merak Atlası ana sayfa">
        <span class="sidebar-logo-mark">
            <img
                src="/images/merak-atlasi-logo.png"
                alt="Merak Atlası logosu"
                width="40"
                height="40"
            />
        </span>

        <div class="sidebar-logo-text">
            <strong>MERAK ATLASI</strong>
            <small>Keşfet. Oku. İzle.</small>
        </div>
    </a>

    <div class="sidebar-scroll">
        <div class="sidebar-main">

        <div class="sidebar-section-label">
            KEŞFET
        </div>

        <nav class="sidebar-nav">

            <a
                href="/"
                class:list={["sidebar-link", { active: isActive("/") }]}
                aria-current={isActive("/") ? "page" : undefined}
                aria-label="Ana Sayfa"
                title="Ana Sayfa"
            >
                <span class="sidebar-icon">⌂</span>
                <span>Ana Sayfa</span>
            </a>

            <a
                href="/film-dizi/"
                class:list={["sidebar-link", { active: isActive("/film-dizi/") }]}
                aria-current={isActive("/film-dizi/") ? "page" : undefined}
                aria-label="Filmler & Diziler"
                title="Filmler & Diziler"
            >
                <span class="sidebar-icon">▶</span>
                <span>Filmler & Diziler</span>
            </a>

            <a
                href="/astroloji/"
                class:list={["sidebar-link", { active: isActive("/astroloji/") }]}
                aria-current={isActive("/astroloji/") ? "page" : undefined}
                aria-label="Astroloji"
                title="Astroloji"
            >
                <span class="sidebar-icon">✦</span>
                <span>Astroloji</span>
            </a>

            <a
                href="/yemek-tarifleri/"
                class:list={["sidebar-link", { active: isActive("/yemek-tarifleri/") }]}
                aria-current={isActive("/yemek-tarifleri/") ? "page" : undefined}
                aria-label="Yemek Tarifleri"
                title="Yemek Tarifleri"
            >
                <span class="sidebar-icon">♨</span>
                <span>Yemek Tarifleri</span>
            </a>

            <a
                href="/kultur-sanat/"
                class:list={["sidebar-link", { active: isActive("/kultur-sanat/") }]}
                aria-current={isActive("/kultur-sanat/") ? "page" : undefined}
                aria-label="Kültür & Sanat"
                title="Kültür & Sanat"
            >
                <span class="sidebar-icon">◇</span>
                <span>Kültür & Sanat</span>
            </a>

            <a
                href="/ruya-tabirleri/"
                class:list={["sidebar-link", { active: isActive("/ruya-tabirleri/") }]}
                aria-current={isActive("/ruya-tabirleri/") ? "page" : undefined}
                aria-label="Rüya Tabirleri"
                title="Rüya Tabirleri"
            >
                <span class="sidebar-icon">☾</span>
                <span>Rüya Tabirleri</span>
            </a>

            <a
                href="/kisisel-gelisim/"
                class:list={["sidebar-link", { active: isActive("/kisisel-gelisim/") }]}
                aria-current={isActive("/kisisel-gelisim/") ? "page" : undefined}
                aria-label="Kişisel Gelişim"
                title="Kişisel Gelişim"
            >
                <span class="sidebar-icon">◎</span>
                <span>Kişisel Gelişim</span>
            </a>

            <a
                href="/evcil-hayvanlar/"
                class:list={["sidebar-link", { active: isActive("/evcil-hayvanlar/") }]}
                aria-current={isActive("/evcil-hayvanlar/") ? "page" : undefined}
                aria-label="Evcil Hayvanlar"
                title="Evcil Hayvanlar"
            >
                <span class="sidebar-icon">🐾</span>
                <span>Evcil Hayvanlar</span>
            </a>

            </nav>
        </div>

        <div class="sidebar-bottom">

        <div class="sidebar-divider"></div>

        <button
            class="theme-toggle"
            id="themeButton"
            type="button"
            aria-label="Açık temaya geç"
            aria-pressed="false"
        >
            <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true">☀</span>
            <span class="theme-toggle-track" aria-hidden="true"><span></span></span>
            <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true">☾</span>
        </button>

        <a
            href="/favorilerim/"
            class:list={["sidebar-secondary-link", { active: isActive("/favorilerim/") }]}
            aria-current={isActive("/favorilerim/") ? "page" : undefined}
            aria-label="Favorilerim"
            title="Favorilerim"
        >
            <span class="sidebar-icon">♡</span>
            <span>Favorilerim</span>
        </a>

        <a href="/giris/" class="sidebar-login" id="sidebarGuest" aria-label="Giriş Yap" title="Giriş Yap">
            <span>●</span>

            <div>
                <strong>Giriş Yap</strong>
                <small>Favorilerini ve yorumlarını yönet</small>
            </div>
        </a>

        <div class="sidebar-authenticated" id="sidebarAuthenticated" hidden>
            <a
                class:list={["sidebar-account", { active: isActive("/hesabim/") }]}
                href="/hesabim/"
                aria-current={isActive("/hesabim/") ? "page" : undefined}
                aria-label="Hesabım"
                title="Hesabım"
            >
                <span aria-hidden="true">●</span>

                <div>
                    <strong id="sidebarUserDisplayName">Hesabım</strong>
                    <small id="sidebarUsername"></small>
                </div>
            </a>

            <button class="sidebar-logout" id="sidebarLogout" type="button" aria-label="Çıkış Yap" title="Çıkış Yap">
                <span aria-hidden="true">↪</span>
                <span>Çıkış Yap</span>
            </button>
        </div>

        </div>
    </div>

</aside>

<script>
    import { supabase } from "../lib/supabase.js";

    const guestLink = document.getElementById("sidebarGuest");
    const authenticatedArea = document.getElementById("sidebarAuthenticated");
    const userDisplayName = document.getElementById("sidebarUserDisplayName");
    const usernameText = document.getElementById("sidebarUsername");
    const logoutButton = document.getElementById("sidebarLogout");

    const renderProfile = (profile, email = "") => {
        const username = profile?.username?.trim();
        const displayName = profile?.display_name?.trim() || username || "Hesabım";
        if (userDisplayName) userDisplayName.textContent = displayName;
        if (usernameText) usernameText.textContent = username ? `@${username}` : email;
    };

    const renderSession = async (session) => {
        const isSignedIn = Boolean(session?.user);

        if (guestLink) guestLink.hidden = isSignedIn;
        if (authenticatedArea) authenticatedArea.hidden = !isSignedIn;
        if (!session?.user) {
            renderProfile(null);
            return;
        }

        const { data: profile } = await supabase
            .from("profiles")
            .select("username, display_name")
            .eq("id", session.user.id)
            .maybeSingle();

        renderProfile(profile, session.user.email ?? "");
    };

    const { data: { session } } = await supabase.auth.getSession();
    await renderSession(session);

    const { data: authListener } = supabase.auth.onAuthStateChange((_event, nextSession) => {
        void renderSession(nextSession);
    });

    document.addEventListener("popcorn:profile-updated", (event) => {
        renderProfile(event.detail);
    });

    logoutButton?.addEventListener("click", async () => {
        logoutButton.disabled = true;
        const { error } = await supabase.auth.signOut({ scope: "local" });

        if (error) {
            logoutButton.disabled = false;
            window.alert("Çıkış yapılırken bir hata oluştu. Lütfen tekrar deneyin.");
            return;
        }

        window.location.replace("/");
    });

    document.addEventListener("astro:before-swap", () => {
        authListener.subscription.unsubscribe();
    }, { once: true });
</script>
