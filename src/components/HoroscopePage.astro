---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommentSection from "./CommentSection.astro";

const { signs } = Astro.props;
---

<BaseLayout
    title="Burçlar: 12 Burcun Genel Özellikleri | Merak Atlası"
    description="Koç'tan Balık'a on iki burcun genel karakterini, güçlü yönlerini ve sosyal özelliklerini keşfedin."
    canonicalPath="/astroloji/burclar/"
>
    <div class="page-container horoscope-page">

        <!-- BREADCRUMB -->
        <nav class="breadcrumb" aria-label="Sayfa yolu">
            <a href="/">Ana Sayfa</a>
            <span aria-hidden="true">/</span>

            <a href="/astroloji/">Astroloji</a>
            <span aria-hidden="true">/</span>

            <span aria-current="page">
                Burçlar
            </span>
        </nav>


        <!-- PAGE HEADER -->
        <header class="horoscope-heading">

            <span class="eyebrow">
                ASTROLOJİ REHBERİ
            </span>

            <h1>Burçlar ve Genel Özellikleri</h1>

            <p class="horoscope-intro">
                On iki burcun karakterini, güçlü yönlerini, ilişkilerdeki yaklaşımını
                ve dikkat edebileceği özellikleri zamansız bir rehberle keşfet.
            </p>

        </header>


        <!-- QUICK NAV -->
        <div class="horoscope-quick-nav-wrapper">

            <span class="horoscope-quick-nav-title">
                Burcuna Git
            </span>

            <nav
                class="horoscope-quick-nav"
                aria-label="Burçlara hızlı geçiş"
            >
                {signs.map((sign) => (
                    <a href={`#${sign.key}`}>
                        {sign.name}
                    </a>
                ))}
            </nav>

        </div>


        <!-- SIGNS -->
        <div class="horoscope-list">

            {signs.map((sign, index) => (
                    <>

                        <article
                            class="horoscope-section"
                            id={sign.key}
                        >

                            <!-- IMAGE -->
                            <figure class="horoscope-visual">

                                <img
                                    src={
                                        sign.image ||
                                        "/images/horoscope-placeholder.svg"
                                    }
                                    alt={`${sign.name} burcu simgesel görseli`}
                                    loading="lazy"
                                    onerror="this.onerror=null; this.src='/images/horoscope-placeholder.svg';"
                                />

                            </figure>


                            <!-- CONTENT -->
                            <div class="horoscope-copy">

                                <span class="eyebrow">
                                    BURÇ PROFİLİ
                                </span>

                                <h2>
                                    {sign.name} Burcu
                                </h2>

                                <p>
                                    {sign.text}
                                </p>

                            </div>

                        </article>


                        {(index + 1) % 4 === 0 &&
                            index < signs.length - 1 && (

                            <div
                                class="ad-placeholder horoscope-ad"
                                aria-label="Reklam alanı"
                            >
                                <span>REKLAM</span>
                            </div>

                        )}

                    </>
            ))}

        </div>


        <CommentSection contentKey="horoscope:zodiac-signs" />

    </div>
    <button
    class="scroll-top-button"
    id="scrollTopButton"
    type="button"
    aria-label="Sayfanın başına dön"
    title="Yukarı çık"
>
    ↑
</button>

<script>
    const scrollTopButton = document.getElementById("scrollTopButton");

    const updateScrollButton = () => {
        if (!scrollTopButton) return;

        scrollTopButton.classList.toggle(
            "is-visible",
            window.scrollY > 500
        );
    };

    window.addEventListener("scroll", updateScrollButton, {
        passive: true
    });

    scrollTopButton?.addEventListener("click", () => {
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    });

    updateScrollButton();
</script>
</BaseLayout>
