---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "./ArticleCard.astro";
import AdSlot from "./AdSlot.astro";
import articles from "../data/articles.json";
import { sortArticlesNewest } from "../utils/articles.js";

const { title, description, category } = Astro.props;
const categoryArticles = sortArticlesNewest(
    articles.filter((article) => article.category === category)
);
---

<BaseLayout
    title={`${title} | Merak Atlası`}
    description={description}
    canonicalPath={Astro.url.pathname}
>
    <div class="page-container category-page">
        <header class="page-heading">
            <span class="eyebrow">MERAK ATLASI</span>
            <h1>{title}</h1>
            <p>{description}</p>
        </header>

        <slot name="featured" />

        <AdSlot placement="listContent" />

        <section class="category-content" aria-labelledby="category-content-title">
            <div class="section-header">
                <h2 id="category-content-title">Yeni İçerikler</h2>
            </div>

            {categoryArticles.length > 0 ? (
                <div class="article-list">
                    {categoryArticles.map((article) => <ArticleCard article={article} />)}
                </div>
            ) : (
                <div class="article-empty-state">
                    <h3>Henüz içerik yok</h3>
                    <p>Bu kategoriye eklenen makaleler burada listelenecek.</p>
                </div>
            )}
        </section>

        <AdSlot placement="listContent" />
    </div>
</BaseLayout>
