---
const { item } = Astro.props;
const itemUrl = `/film-dizi/${item.slug}/`;
---

<article class="movie-card">

    <a href={itemUrl} class="movie-card-poster">

        <img
            src={item.image || "/images/poster-placeholder.svg"}
            alt={`${item.title} posteri`}
            loading="lazy"
            width="500"
            height="750"
            onerror="this.onerror=null; this.src='/images/poster-placeholder.svg';"

        />

        <span class="movie-rating">
            ⭐ {item.rating}
        </span>

    </a>

    <div class="movie-card-info">

        <h3>
            <a href={itemUrl}>
                {item.title}
            </a>
        </h3>

        <p>
            {item.year} • {item.genre}
        </p>

        <button
            class="favorite-button"
            type="button"
            data-favorite-button
            data-media-slug={item.slug}
            aria-pressed="false"
        >
            🤍 Favori
        </button>

    </div>

</article>
