---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MovieCard from "../../components/MovieCard.astro";
import CommentSection from "../../components/CommentSection.astro";
import StructuredData from "../../components/StructuredData.astro";
import data from "../../data/data.json";
import { createMediaStructuredData } from "../../utils/seo.js";
import { validateContentRoutes } from "../../utils/contentRoutes.js";

const items = [...data.movies, ...data.series];

export function getStaticPaths() {
    const validatedItems = validateContentRoutes([...data.movies, ...data.series], {
        contentType: "film/dizi",
        getRoute: (item) => `/film-dizi/${item.slug}/`
    });

    return validatedItems.map((item) => ({
        params: { slug: item.slug },
        props: { item }
    }));
}

const { item } = Astro.props;
const relatedItems = items
    .filter((candidate) => candidate.genre === item.genre && candidate.id !== item.id)
    .slice(0, 4);
const typeLabel = item.type === "movie" ? "Film" : "Dizi";
const canonicalPath = `/film-dizi/${item.slug}/`;
const structuredData = createMediaStructuredData({ item, canonicalPath });
---

<BaseLayout
    title={`${item.title} | Merak Atlası`}
    description={item.description}
    canonicalPath={canonicalPath}
    image={item.image}
    type={item.type === "movie" ? "video.movie" : "video.tv_show"}
>
    <StructuredData data={structuredData} />
    <article class="page-container media-detail">
        <a class="back-link" href="/film-dizi/">← Filmler & Diziler'e dön</a>

        <div class="media-detail-hero">
            <div class="detail-poster">
                <img
                    src={item.image || "/images/poster-placeholder.svg"}
                    alt={`${item.title} posteri`}
                    width="500"
                    height="750"
                    onerror="this.onerror=null; this.src='/images/poster-placeholder.svg';"
                />
            </div>

            <div class="detail-content">
                <span class="type-badge">{typeLabel}</span>
                <h1>{item.title}</h1>

                <dl class="detail-meta">
                    <div><dt>Yıl</dt><dd>{item.year}</dd></div>
                    <div><dt>Puan</dt><dd>⭐ {item.rating}</dd></div>
                    <div><dt>Tür</dt><dd>{item.genre}</dd></div>
                </dl>

                <p class="detail-description">{item.description}</p>

                <button
                    class="favorite-button detail-favorite"
                    type="button"
                    data-favorite-button
                    data-media-slug={item.slug}
                    aria-pressed="false"
                >
                    🤍 Favori
                </button>
            </div>
        </div>

        <div class="ad-placeholder" aria-label="Reklam alanı">Reklam Alanı</div>

        {relatedItems.length > 0 && (
            <section class="related-section" aria-labelledby="related-title">
                <div class="section-header">
                    <h2 id="related-title">Bunlar da ilginizi çekebilir</h2>
                </div>
                <div class="media-grid related-grid">
                    {relatedItems.map((relatedItem) => <MovieCard item={relatedItem} />)}
                </div>
            </section>
        )}

        <CommentSection contentKey={`film-dizi:${item.slug}`} />
    </article>
</BaseLayout>
