---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Hesabım | Popcorn"
    description="Popcorn hesap bilgilerinizi yönetin."
>
    <section class="page-container account-page">
        <div class="account-loading" id="accountLoading" role="status">
            Hesap bilgileri yükleniyor…
        </div>

        <div id="accountContent" hidden>
            <header class="account-hero">
                <div>
                    <span class="eyebrow">POPCORN HESABIN</span>
                    <h1 id="accountUsername">@kullanici</h1>
                    <p id="accountEmail"></p>
                    <small id="accountCreatedAt"></small>
                </div>

                <div class="account-hero-actions">
                    <a href="/favorilerim/">Favorilerime Git</a>
                    <button id="accountLogout" type="button">Çıkış Yap</button>
                </div>
            </header>

            <div class="auth-message account-message" id="accountMessage" role="status" aria-live="polite" hidden></div>

            <div class="account-settings">
                <form class="account-setting-card auth-form" id="usernameForm" novalidate>
                    <div>
                        <h2>Kullanıcı adı</h2>
                        <p>3-24 karakter; yalnızca küçük harf, rakam ve _ kullan.</p>
                    </div>
                    <label for="accountUsernameInput">
                        <span>Yeni kullanıcı adı</span>
                        <input
                            id="accountUsernameInput"
                            type="text"
                            autocomplete="username"
                            minlength="3"
                            maxlength="24"
                            pattern="[a-z0-9_]{3,24}"
                            required
                        />
                    </label>
                    <button class="auth-submit" type="submit">Kullanıcı Adını Güncelle</button>
                </form>

                <form class="account-setting-card auth-form" id="emailForm" novalidate>
                    <div>
                        <h2>E-posta</h2>
                        <p>Yeni adresin için doğrulama gerekebilir.</p>
                    </div>
                    <label for="accountEmailInput">
                        <span>Yeni e-posta</span>
                        <input id="accountEmailInput" type="email" autocomplete="email" required />
                    </label>
                    <button class="auth-submit" type="submit">E-postayı Güncelle</button>
                </form>

                <form class="account-setting-card auth-form" id="passwordForm" novalidate>
                    <div>
                        <h2>Şifre</h2>
                        <p>Yeni şifren en az 8 karakter olmalı.</p>
                    </div>
                    <label for="accountPasswordInput">
                        <span>Yeni şifre</span>
                        <div class="auth-password-field">
                            <input
                                id="accountPasswordInput"
                                type="password"
                                autocomplete="new-password"
                                minlength="8"
                                required
                            />
                            <button type="button" data-account-password-toggle="accountPasswordInput" aria-label="Şifreyi göster">Göster</button>
                        </div>
                    </label>
                    <label for="accountPasswordAgainInput">
                        <span>Yeni şifre tekrar</span>
                        <div class="auth-password-field">
                            <input
                                id="accountPasswordAgainInput"
                                type="password"
                                autocomplete="new-password"
                                minlength="8"
                                required
                            />
                            <button type="button" data-account-password-toggle="accountPasswordAgainInput" aria-label="Şifreyi göster">Göster</button>
                        </div>
                    </label>
                    <button class="auth-submit" type="submit">Şifreyi Güncelle</button>
                </form>
            </div>
        </div>
    </section>

    <script>
        import { supabase } from "../lib/supabase.js";

        const usernamePattern = /^[a-z0-9_]{3,24}$/;
        const loading = document.getElementById("accountLoading");
        const content = document.getElementById("accountContent");
        const usernameHeading = document.getElementById("accountUsername");
        const emailText = document.getElementById("accountEmail");
        const createdAtText = document.getElementById("accountCreatedAt");
        const usernameForm = document.getElementById("usernameForm");
        const emailForm = document.getElementById("emailForm");
        const passwordForm = document.getElementById("passwordForm");
        const usernameInput = document.getElementById("accountUsernameInput");
        const emailInput = document.getElementById("accountEmailInput");
        const passwordInput = document.getElementById("accountPasswordInput");
        const passwordAgainInput = document.getElementById("accountPasswordAgainInput");
        const message = document.getElementById("accountMessage");
        const logoutButton = document.getElementById("accountLogout");
        let currentUser;

        const showMessage = (text, type) => {
            if (!message) return;
            message.textContent = text;
            message.className = `auth-message account-message is-${type}`;
            message.hidden = false;
            message.scrollIntoView({ behavior: "smooth", block: "nearest" });
        };

        const setFormLoading = (form, isLoading) => {
            if (!(form instanceof HTMLFormElement)) return;
            form.querySelectorAll("input, button").forEach((control) => {
                control.disabled = isLoading;
            });
        };

        const { data: { session } } = await supabase.auth.getSession();

        if (!session?.user) {
            window.location.replace("/giris/");
        } else {
            currentUser = session.user;
            const { data: profile, error } = await supabase
                .from("profiles")
                .select("username")
                .eq("id", currentUser.id)
                .single();

            if (error || !profile) {
                if (loading) loading.textContent = "Hesap bilgileri yüklenemedi. Lütfen daha sonra tekrar deneyin.";
            } else {
                if (usernameHeading) usernameHeading.textContent = `@${profile.username}`;
                if (emailText) emailText.textContent = currentUser.email ?? "";
                if (createdAtText) {
                    const date = new Intl.DateTimeFormat("tr-TR", { dateStyle: "long" })
                        .format(new Date(currentUser.created_at));
                    createdAtText.textContent = `Hesap oluşturma tarihi: ${date}`;
                }
                if (usernameInput instanceof HTMLInputElement) usernameInput.value = profile.username;
                if (emailInput instanceof HTMLInputElement) emailInput.value = currentUser.email ?? "";
                if (loading) loading.hidden = true;
                if (content) content.hidden = false;
            }
        }

        usernameForm?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!(usernameInput instanceof HTMLInputElement) || !currentUser) return;

            const username = usernameInput.value.trim();
            if (!usernamePattern.test(username)) {
                showMessage("Kullanıcı adı 3-24 karakter olmalı ve yalnızca küçük harf, rakam veya _ içermelidir.", "error");
                usernameInput.focus();
                return;
            }

            setFormLoading(usernameForm, true);
            showMessage("Kullanıcı adı kontrol ediliyor…", "loading");

            const { data: isAvailable, error: availabilityError } = await supabase
                .rpc("is_username_available", { candidate: username });

            if (availabilityError || !isAvailable) {
                showMessage(
                    availabilityError
                        ? "Kullanıcı adı şu anda kontrol edilemiyor."
                        : "Bu kullanıcı adı zaten kullanılıyor.",
                    "error"
                );
                setFormLoading(usernameForm, false);
                return;
            }

            const { error } = await supabase
                .from("profiles")
                .update({ username })
                .eq("id", currentUser.id);

            if (error) {
                showMessage("Kullanıcı adı güncellenemedi. Başka bir kullanıcı adı deneyin.", "error");
            } else {
                if (usernameHeading) usernameHeading.textContent = `@${username}`;
                showMessage("Kullanıcı adınız güncellendi.", "success");
            }
            setFormLoading(usernameForm, false);
        });

        emailForm?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!(emailInput instanceof HTMLInputElement)) return;

            if (!emailInput.validity.valid) {
                showMessage("Geçerli bir e-posta adresi girin.", "error");
                emailInput.focus();
                return;
            }

            setFormLoading(emailForm, true);
            showMessage("E-posta adresiniz güncelleniyor…", "loading");
            const { data, error } = await supabase.auth.updateUser({ email: emailInput.value.trim() });

            if (error) {
                showMessage("E-posta adresi güncellenemedi. Lütfen tekrar deneyin.", "error");
            } else {
                if (emailText && data.user.email) emailText.textContent = data.user.email;
                showMessage("E-posta değişikliği alındı. Gönderilen doğrulama bağlantısını açmanız gerekebilir.", "success");
            }
            setFormLoading(emailForm, false);
        });

        passwordForm?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!(passwordInput instanceof HTMLInputElement)
                || !(passwordAgainInput instanceof HTMLInputElement)) return;

            if (passwordInput.value.length < 8) {
                showMessage("Yeni şifre en az 8 karakter olmalıdır.", "error");
                passwordInput.focus();
                return;
            }

            if (passwordInput.value !== passwordAgainInput.value) {
                showMessage("Yeni şifreler eşleşmiyor.", "error");
                passwordAgainInput.focus();
                return;
            }

            setFormLoading(passwordForm, true);
            showMessage("Şifreniz güncelleniyor…", "loading");
            const { error } = await supabase.auth.updateUser({ password: passwordInput.value });

            if (error) {
                showMessage("Şifre güncellenemedi. Lütfen tekrar deneyin.", "error");
            } else {
                passwordForm.reset();
                showMessage("Şifreniz güncellendi.", "success");
            }
            setFormLoading(passwordForm, false);
        });

        document.querySelectorAll("[data-account-password-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
                const input = document.getElementById(button.dataset.accountPasswordToggle);
                if (!(input instanceof HTMLInputElement)) return;
                const willShow = input.type === "password";
                input.type = willShow ? "text" : "password";
                button.textContent = willShow ? "Gizle" : "Göster";
            });
        });

        logoutButton?.addEventListener("click", async () => {
            if (!(logoutButton instanceof HTMLButtonElement)) return;
            logoutButton.disabled = true;
            const { error } = await supabase.auth.signOut();
            if (error) {
                logoutButton.disabled = false;
                showMessage("Çıkış yapılamadı. Lütfen tekrar deneyin.", "error");
                return;
            }
            window.location.assign("/giris/");
        });
    </script>
</BaseLayout>
