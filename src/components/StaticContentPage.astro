---
import BaseLayout from "../layouts/BaseLayout.astro";

const {
    title,
    description,
    eyebrow = "MERAK ATLASI",
    intro,
    updated
} = Astro.props;

---

<BaseLayout title={title} description={description} canonicalPath={Astro.url.pathname}>
    <article class="static-page">
        <nav class="breadcrumb" aria-label="İçerik yolu">
            <a href="/">Ana Sayfa</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{title.replace(" | Merak Atlası", "")}</span>
        </nav>

        <header class="static-page-header">
            <span class="eyebrow">{eyebrow}</span>
            <h1>{title.replace(" | Merak Atlası", "")}</h1>
            <p>{intro}</p>
            {updated && <time datetime={updated.datetime}>{updated.label}</time>}
        </header>

        <div class="static-page-body">
            <slot />
        </div>
    </article>
</BaseLayout>
