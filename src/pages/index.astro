---
import BaseLayout from "../layouts/BaseLayout.astro";
import MovieCard from "../components/MovieCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import HoroscopeFeatureCard from "../components/HoroscopeFeatureCard.astro";
import data from "../data/data.json";
import articles from "../data/articles.json";
import horoscopes from "../data/horoscopes.json";
import { sortArticlesNewest } from "../utils/articles.js";
import { getLatestHoroscope } from "../utils/horoscopes.js";

const featuredMovies = data.movies.slice(0, 4);
const latestHoroscope = getLatestHoroscope(horoscopes);
const articleSections = [
    { category: "astroloji", title: "✨ Astroloji" },
    { category: "kultur-sanat", title: "🎨 Kültür & Sanat" },
    { category: "yemek-tarifleri", title: "🍴 Yemek Tarifleri" },
    { category: "ruya-tabirleri", title: "🌙 Rüya Tabirleri" },
    { category: "kisisel-gelisim", title: "🧠 Kişisel Gelişim" }
].map((section) => ({
    ...section,
    articles: sortArticlesNewest(
        articles.filter((article) => article.category === section.category)
    ).slice(0, 3)
}));
---


<BaseLayout
    title="Popcorn | Film, Astroloji, Kültür ve Lifestyle"
    description="Film, dizi, astroloji, yemek tarifleri, kültür sanat, rüya tabirleri ve kişisel gelişim içerikleri."
>

    <div class="home-container">

        <aside class="home-welcome" id="homeWelcome" hidden aria-live="polite">
            <span aria-hidden="true">✦</span>
            <p>Hoş geldin, <strong id="homeWelcomeUsername"></strong></p>
        </aside>

        <section class="home-hero">

            <div class="home-hero-content">
                <span class="home-hero-label">
                    POPCORN'DA BUGÜN
                </span>

                <h1>Keşfedecek çok şey var.</h1>

                <p>
                    Film ve dizilerden günlük burç yorumlarına,
                    yemek tariflerinden kültür ve sanata kadar
                    Popcorn'un öne çıkan içeriklerini keşfet.
                </p>
            </div>

        </section>


        <section class="home-section">

            <div class="section-header">
                <h2>🎬 Filmler & Diziler</h2>
                <a href="/film-dizi/">Tümünü Gör →</a>
            </div>

           <div class="placeholder-grid">
    {featuredMovies.map((movie) => (
        <MovieCard item={movie} />
    ))}
</div>

        </section>


        <section class="home-section">
            <HoroscopeFeatureCard horoscope={latestHoroscope} />
        </section>


        <div class="ad-placeholder">
            Reklam Alanı
        </div>


        {articleSections.map((section) => (
            <section class="home-section">
                <div class="section-header">
                    <h2>{section.title}</h2>
                    <a href={`/${section.category}/`}>Tümünü Gör →</a>
                </div>

                <div class="article-list home-article-list">
                    {section.articles.map((article) => <ArticleCard article={article} />)}
                </div>
            </section>
        ))}

    </div>

    <script>
        import { supabase } from "../lib/supabase.js";

        const welcome = document.getElementById("homeWelcome");
        const welcomeUsername = document.getElementById("homeWelcomeUsername");

        const renderWelcome = async (session) => {
            if (!session?.user) {
                if (welcome) welcome.hidden = true;
                return;
            }

            const { data: profile } = await supabase
                .from("profiles")
                .select("username")
                .eq("id", session.user.id)
                .maybeSingle();

            if (!profile?.username) {
                if (welcome) welcome.hidden = true;
                return;
            }

            if (welcomeUsername) welcomeUsername.textContent = `@${profile.username}`;
            if (welcome) welcome.hidden = false;
        };

        const { data: { session } } = await supabase.auth.getSession();
        await renderWelcome(session);

        supabase.auth.onAuthStateChange((_event, nextSession) => {
            void renderWelcome(nextSession);
        });
    </script>

</BaseLayout>
