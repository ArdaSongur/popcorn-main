---
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site.js";
import { adsConfig, isAdsenseEnabled } from "../config/ads.js";
import { toAbsoluteUrl } from "../utils/seo.js";
import "../styles/global.css";

const {
    title = siteConfig.defaultTitle,
    description = siteConfig.defaultDescription,
    canonicalPath = Astro.url.pathname,
    image = siteConfig.defaultOgImage,
    type = "website",
    noindex = false
} = Astro.props;
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const socialImageUrl = toAbsoluteUrl(image);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const adsenseEnabled = isAdsenseEnabled();
const adsenseScriptUrl = adsenseEnabled
    ? `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(adsConfig.publisherId.trim())}`
    : "";
---

<!doctype html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1117" />
    <link rel="icon" type="image/png" href="/images/merak-atlasi-logo.png" />
    <link rel="apple-touch-icon" href="/images/merak-atlasi-logo.png" />
    {adsenseEnabled && (
        <script
            is:inline
            async
            crossorigin="anonymous"
            src={adsenseScriptUrl}
        ></script>
    )}

    <script is:inline>
        (() => {
            try {
                const recoveryFlowActive = sessionStorage.getItem("popcorn-password-recovery") === "active";
                const normalizedPath = window.location.pathname.replace(/\/+$/, "") || "/";
                const hashParameters = new URLSearchParams(window.location.hash.slice(1));
                const queryParameters = new URLSearchParams(window.location.search);
                const recoveryLinkInUrl = hashParameters.get("type") === "recovery"
                    || queryParameters.get("type") === "recovery";

                if (recoveryLinkInUrl && normalizedPath !== "/sifre-yenile") {
                    const recoveryUrl = `/sifre-yenile/${window.location.search}${window.location.hash}`;
                    window.location.replace(recoveryUrl);
                    return;
                }

                if (recoveryFlowActive && normalizedPath !== "/sifre-yenile") {
                    window.location.replace("/sifre-yenile/");
                    return;
                }

                const savedTheme = localStorage.getItem("theme");
                document.documentElement.dataset.theme = savedTheme === "light" ? "light" : "dark";
                if (localStorage.getItem("sidebar-collapsed") === "true") {
                    document.documentElement.classList.add("sidebar-collapsed");
                }
            } catch {
                document.documentElement.dataset.theme = "dark";
            }
        })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
</head>

<body>

    <button class="mobile-menu-button" id="menuButton" aria-label="Menüyü aç" aria-expanded="false" aria-controls="sidebar">
        ☰
    </button>

    <button class="sidebar-backdrop" id="sidebarBackdrop" type="button" aria-label="Menüyü kapat" tabindex="-1"></button>

    <div class="sidebar-swipe-edge" id="sidebarSwipeEdge" aria-hidden="true"></div>

    <Sidebar />

    <Topbar />

    <main class="site-content">
        <slot />
    </main>

    <Footer />

    <script>
        import { initFavoriteButtons } from "../lib/favorites.js";

        const button = document.getElementById("menuButton");
        const sidebar = document.getElementById("sidebar");
        const backdrop = document.getElementById("sidebarBackdrop");
        const swipeEdge = document.getElementById("sidebarSwipeEdge");
        const mobileCloseButton = document.getElementById("sidebarCloseButton");
        const collapseButton = document.getElementById("sidebarCollapseButton");
        const mobileMedia = window.matchMedia("(max-width: 900px)");
        let lockedScrollY = 0;

        const lockPageScroll = () => {
            if (document.body.classList.contains("mobile-menu-open")) return;
            lockedScrollY = window.scrollY;
            document.body.style.position = "fixed";
            document.body.style.top = `-${lockedScrollY}px`;
            document.body.style.right = "0";
            document.body.style.left = "0";
        };

        const unlockPageScroll = () => {
            if (!document.body.classList.contains("mobile-menu-open")) return;
            document.body.style.position = "";
            document.body.style.top = "";
            document.body.style.right = "";
            document.body.style.left = "";
            window.scrollTo(0, lockedScrollY);
        };

        const setMobileMenu = (isOpen) => {
            const shouldOpen = Boolean(isOpen && mobileMedia.matches);
            if (shouldOpen) lockPageScroll();
            else unlockPageScroll();
            sidebar?.classList.toggle("open", shouldOpen);
            document.body.classList.toggle("mobile-menu-open", shouldOpen);
            button?.setAttribute("aria-expanded", String(shouldOpen));
            button?.setAttribute("aria-label", shouldOpen ? "Menüyü kapat" : "Menüyü aç");
        };

        const openSidebar = () => setMobileMenu(true);
        const closeSidebar = () => setMobileMenu(false);

        button?.addEventListener("click", () => {
            if (sidebar?.classList.contains("open")) closeSidebar();
            else openSidebar();
        });

        mobileCloseButton?.addEventListener("click", closeSidebar);
        backdrop?.addEventListener("click", closeSidebar);
        sidebar?.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeSidebar);
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeSidebar();
        });

        let swipeGesture = null;
        let suppressGestureClick = false;
        const swipeThreshold = 60;

        const releaseSwipeCapture = () => {
            if (!swipeGesture?.captureTarget?.hasPointerCapture?.(swipeGesture.pointerId)) return;
            swipeGesture.captureTarget.releasePointerCapture(swipeGesture.pointerId);
        };

        const resetSwipe = () => {
            releaseSwipeCapture();
            swipeGesture = null;
        };

        const beginSwipe = (event, mode, captureTarget = null) => {
            if (!mobileMedia.matches || !event.isPrimary) return;
            swipeGesture = {
                pointerId: event.pointerId,
                mode,
                startX: event.clientX,
                startY: event.clientY,
                direction: null,
                captureTarget
            };

            try {
                captureTarget?.setPointerCapture?.(event.pointerId);
            } catch {
                // Pointer capture desteklenmese de global event takibi devam eder.
            }
        };

        document.addEventListener("pointerdown", (event) => {
            if (!mobileMedia.matches || !event.isPrimary || !sidebar) return;
            if (event.target instanceof Element && event.target.closest(".topbar-nav")) return;

            if (sidebar.classList.contains("open")) {
                if (event.target instanceof Node && sidebar.contains(event.target)) {
                    beginSwipe(event, "close");
                }
                return;
            }

            if (event.clientX <= 28) beginSwipe(event, "open", swipeEdge);
        }, true);

        const handleSwipeMovement = (event) => {
            if (!swipeGesture || event.pointerId !== swipeGesture.pointerId) return;

            const deltaX = event.clientX - swipeGesture.startX;
            const deltaY = event.clientY - swipeGesture.startY;
            const absoluteX = Math.abs(deltaX);
            const absoluteY = Math.abs(deltaY);

            if (!swipeGesture.direction && Math.max(absoluteX, absoluteY) >= 8) {
                swipeGesture.direction = absoluteX > absoluteY * 1.2 ? "horizontal" : "vertical";
            }

            if (swipeGesture.direction === "vertical") {
                resetSwipe();
                return;
            }

            if (swipeGesture.direction !== "horizontal") return;
            if (event.cancelable) event.preventDefault();

            const shouldClose = swipeGesture.mode === "close" && deltaX <= -swipeThreshold;
            const shouldOpen = swipeGesture.mode === "open" && deltaX >= swipeThreshold;

            if (shouldClose || shouldOpen) {
                suppressGestureClick = true;
                if (shouldOpen) openSidebar();
                else closeSidebar();
                resetSwipe();
                window.setTimeout(() => { suppressGestureClick = false; }, 400);
            }
        };

        document.addEventListener("pointermove", handleSwipeMovement, { passive: false });

        document.addEventListener("pointerup", (event) => {
            if (!swipeGesture || event.pointerId !== swipeGesture.pointerId) return;
            handleSwipeMovement(event);
            resetSwipe();
        });

        document.addEventListener("pointercancel", (event) => {
            if (swipeGesture && event.pointerId === swipeGesture.pointerId) resetSwipe();
        });

        document.addEventListener("click", (event) => {
            if (!suppressGestureClick) return;
            event.preventDefault();
            event.stopImmediatePropagation();
        }, true);

        mobileMedia.addEventListener?.("change", (event) => {
            if (!event.matches) closeSidebar();
        });

        const updateCollapseButton = () => {
            const isCollapsed = document.documentElement.classList.contains("sidebar-collapsed");
            collapseButton?.setAttribute("aria-expanded", String(!isCollapsed));
            collapseButton?.setAttribute("aria-label", isCollapsed ? "Kenar çubuğunu genişlet" : "Kenar çubuğunu daralt");
            collapseButton?.setAttribute("title", isCollapsed ? "Kenar çubuğunu genişlet" : "Kenar çubuğunu daralt");
        };

        updateCollapseButton();
        collapseButton?.addEventListener("click", () => {
            document.documentElement.classList.toggle("sidebar-collapsed");
            const isCollapsed = document.documentElement.classList.contains("sidebar-collapsed");
            try {
                localStorage.setItem("sidebar-collapsed", String(isCollapsed));
            } catch {
                // Tercih kaydedilemese de mevcut sayfada uygulanır.
            }
            updateCollapseButton();
        });

        const themeButton = document.getElementById("themeButton");

        const updateThemeButton = () => {
            const isLight = document.documentElement.dataset.theme === "light";

            themeButton?.setAttribute("aria-pressed", String(isLight));
            themeButton?.setAttribute("aria-label", isLight ? "Koyu temaya geç" : "Açık temaya geç");
        };

        updateThemeButton();

        themeButton?.addEventListener("click", () => {
            const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
            document.documentElement.dataset.theme = nextTheme;

            try {
                localStorage.setItem("theme", nextTheme);
            } catch {
                // Tema yine bu sayfa açık kaldığı sürece uygulanır.
            }

            updateThemeButton();
        });

        initFavoriteButtons();
    </script>

</body>
</html>
